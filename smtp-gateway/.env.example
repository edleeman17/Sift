# SMTP Gateway Configuration
# Copy to .env and customize values

# Your mail server
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=sms@example.com
SMTP_PASSWORD=changeme

# The inbox your iPhone's Shortcuts automation watches (usually your
# iCloud/Gmail/etc address, the one actually on the phone)
TO_ADDRESS=you@icloud.com

# Must match the Shortcuts automation's "Subject Contains" filter exactly
SUBJECT=SIFT-SMS

# Server port (8095 matches imessage-gateway's default, for an easy swap)
PORT=8095
