# SMS Assistant Configuration
# Copy to .env and customize

# Server port
PORT=8091

# Delivery gateway (smtp-gateway/ or imessage-gateway/) that replies get
# sent through - see ../smtp-gateway/README.md or ../imessage-gateway/
GATEWAY_URL=http://localhost:8095
IMESSAGE_GATEWAY_URL=http://localhost:8095

# RESET's SSH access to the Pi running ancs-bridge
PI_HOST=pi@192.168.1.100
SSH_KEY_PATH=/path/to/ssh/key

# PING's health check - whatever ancs-bridge/the Pi's own bridge exposes
PI_HEALTH_URL=http://192.168.1.100:8081/health

# Optional: a REST todo backend for TODO/DONE. Expects
#   GET  {INGEST_URL}/api/items?status=todo&limit=N -> {"items": [...]}
#   POST {INGEST_URL}/ingest {"source", "raw_text"}
#   PATCH {INGEST_URL}/api/items/{id} {"status": "done"}
# Leave blank and adapt commands/todo.py if you don't have one of these.
INGEST_URL=

# Contact/state file paths (bind-mount these, don't bake them into the image)
CONTACTS_FILE=/app/contacts.json
DATA_FILE=/app/data/data.json
PARKING_STATE_FILE=/app/data/parking_state.json

# NAV's "home" shorthand
HOME_ADDRESS=

# WEATHER/RAIN/BRIEFING defaults
DEFAULT_LOCATION=London,UK
DEFAULT_LAT=51.5074
DEFAULT_LON=-0.1278

# Optional: UK Met Office DataHub API key for more accurate forecasts at
# DEFAULT_LOCATION. Falls back to Open-Meteo (no key needed) without it.
MET_OFFICE_API_KEY=

# Dumbphones usually can't render emoji - leave false to have them
# converted to text (e.g. :sun:) before sending.
SUPPORTS_EMOJI=false
